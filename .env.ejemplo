# =====================================================================
# Conexión a Supabase. Copia este archivo como ".env" y llénalo.
# ".env" NO se sube a git. Nunca pegues los valores privados en un chat.
# =====================================================================

# --- Públicos: van dentro de la app y los ve cualquiera que la abra ---
SUPABASE_URL=https://eirouznbikpvnuhdmbnm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Hnud27yTrhtvrhQC5xtX4Q_pXS1FPQD
SUPABASE_JWKS_URL=https://eirouznbikpvnuhdmbnm.supabase.co/auth/v1/.well-known/jwks.json

# --- Privados: solo para scripts y funciones del servidor ---
# Project Settings -> API Keys -> Secret keys (empieza con sb_secret_)
SUPABASE_SECRET_KEY=

# Botón "Connect" (arriba en el panel) -> "Session pooler". Copia el host.
# NO uses "Direct connection": en el plan gratuito solo funciona por IPv6
# y muchas redes de casa o escuela no lo tienen.
SUPABASE_DB_HOST=aws-0-us-west-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.eirouznbikpvnuhdmbnm
# La contraseña de la base (la que pusiste al crear el proyecto).
# Si la perdiste: Project Settings -> Database -> Reset database password.
SUPABASE_DB_PASSWORD=

# --- Correo (Fase 3b): uno de los dos. Luego: python scripts/desplegar.py secretos ---
# Resend (resend.com): para escribirle a cualquier correo necesita un dominio verificado.
RESEND_API_KEY=
# Brevo (brevo.com): basta con verificar una dirección remitente.
BREVO_API_KEY=
# Quién firma los correos. Debe ser el dominio o la dirección verificada en el servicio.
CORREO_REMITENTE=Laboratorio Maker <laboratorio@tudominio.mx>

# --- Avisos al celular (Fase 3b): Firebase -> Configuración del proyecto -> Cuentas de servicio ->
# "Generar nueva clave privada". Guarda el JSON en esta carpeta (está ignorado por git) y pon su nombre:
FIREBASE_CUENTA_SERVICIO_ARCHIVO=
